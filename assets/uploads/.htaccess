# ----------------------------------------------------------------------
# Security: Disable Script Execution in Uploads Directory
# Compatible across Apache 2.4, PHP-FPM, FastCGI, LiteSpeed, and cPanel
# ----------------------------------------------------------------------

# Block all PHP and executable scripts regardless of handler
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php|php[0-9]?|phtml|phar|pl|py|cgi|sh|bash|exe|bat|cmd|pht|shtml)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(php|php[0-9]?|phtml|phar|pl|py|cgi|sh|bash|exe|bat|cmd|pht|shtml)$">
        Order Deny,Allow
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
 